{
  "name": "agentic-playwright-qa",
  "version": "1.0.0",
  "private": false,
  "description": "A safety-bounded LLM agent that tests a local web app with Playwright.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
