# Required to run the LLM-driven agent.
OPENAI_API_KEY=

# Optional: point to any OpenAI-compatible API.
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# The browser agent is locked to the approved MoonOnTheMove website.
# Page content sent to the model is visible public content only.
MAX_AGENT_STEPS=16
